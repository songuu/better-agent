[Unit]
Description=Better Agent same-origin web runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=better-agent-web
Group=better-agent-web
WorkingDirectory=/opt/better-agent/web-current/apps/web
EnvironmentFile=/opt/better-agent/shared/web.env
EnvironmentFile=/opt/better-agent/shared/postgres/env/product.env
ExecStart=/usr/bin/node /opt/better-agent/web-current/apps/web/dist/server.js
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
