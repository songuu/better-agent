{
  "name": "@better-agent/run-core",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic Run fact preparation for Better Agent",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json --pretty false --stopBuildOnErrors",
